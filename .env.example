# Скопируйте в .env на сервере и заполните. .env в git не попадает.

# Домен с A-записью на IP сервера или <IP>.sslip.io, например 203.0.113.10.sslip.io
DOMAIN=

# Секрет подписи токенов: сгенерируйте командой  openssl rand -hex 32
JWT_SECRET=

# Пользователи «логин:пароль[:компания],…». Пусто — только демо-вход в один клик (рекомендуется для публичного демо).
API_USERS=

# Демо-вход: у каждого гостя своя копия этой компании; прогноз считается при старте
DEMO_COMPANY=S02
DEMO_WARMUP=true
DEMO_TTL_HOURS=24

# Ограничения
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MIN=300
RATE_LIMIT_HEAVY_PER_MIN=20
JWT_TTL_MINUTES=720

# Прогноз без входа для проверки на контрольном датасете (POST /api/predict); false — выключить
PUBLIC_PREDICT=true

# Число траекторий Monte Carlo (меньше — быстрее, но шире шум)
CORE_N_SIMS=2000
