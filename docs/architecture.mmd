flowchart LR
  user(["👤 Предприниматель<br/>ноутбук / телефон"])

  subgraph WEB["web/ · React + Vite + TypeScript"]
    direction TB
    ui["Экраны: светофор и график,<br/>«что если», план-факт,<br/>платежи, операции, качество"]
    client["Клиент API<br/>JWT в заголовке"]
    ui --> client
  end

  subgraph API["api/ · FastAPI"]
    direction TB
    auth["🔒 Аутентификация JWT<br/>POST /auth/login"]
    logf["🧹 Фильтр логов<br/>маскирует ИНН, суммы, назначения"]
    routes["REST /api/companies/…<br/>forecast · alerts · scenarios<br/>events · plan-fact · categories"]
    integ["Коннекторы интеграций<br/>/integrations/{name}/sync"]
    store[("Хранилище<br/>выписки, события,<br/>состояние прогноза")]
    auth --> routes
    routes --- logf
    routes <--> store
    integ --> store
  end

  subgraph CORE["core/ · Python-пакет cashflow_core"]
    direction TB
    load["load_statement<br/>чистка: дубли, пропуски,<br/>BOM, «;», ИНН строкой"]
    cat["categorize<br/>категория + уверенность"]
    rec["detect_recurring<br/>зарплата, аренда, ЕНП, кредиты"]
    fc["forecast<br/>остаток по дням:<br/>ожидаемый + диапазон"]
    risk["Риски<br/>дата, сумма, вероятность,<br/>рекомендации"]
    scen["run_scenarios<br/>«что если»"]
    upd["update_forecast<br/>без полного пересчёта"]
    bt["backtest · compare_models<br/>→ reports/metrics.json"]
    load --> cat --> rec --> fc --> risk
    fc --> scen
    fc --> upd
    fc --> bt
  end

  subgraph SRC["Источники данных"]
    direction TB
    bank["🏦 Банк: выписка CSV<br/>(data/raw, 150 компаний)"]
    onec["📒 1С: счета, договоры, зарплата"]
    tax["🧾 Налоговый календарь"]
    reg["📜 Открытые реестры<br/>госконтракты"]
    manual["✍️ Ручной ввод"]
  end

  user -- "работает в браузере" --> ui
  client -- "HTTPS + Bearer JWT<br/>JSON по docs/contract.md" --> auth
  routes -- "DataFrame операций<br/>+ события Event[]" --> load
  risk -- "ForecastResult / ScenarioResult" --> routes
  bank -- "CSV выписки" --> routes
  onec -- "Event: invoice, contract, payroll" --> integ
  tax -- "Event: tax" --> integ
  reg -- "Event: contract" --> integ
  manual -- "POST /events" --> routes
  bt -. "метрики для страницы «Качество»" .-> ui

  classDef web fill:#eef7e1,stroke:#6fa62a,color:#13241c
  classDef api fill:#e6f0ec,stroke:#11553f,color:#13241c
  classDef core fill:#ffffff,stroke:#0b3d2e,color:#13241c
  classDef src fill:#f7f9f5,stroke:#7a8a80,color:#13241c
  class ui,client web
  class auth,logf,routes,integ,store api
  class load,cat,rec,fc,risk,scen,upd,bt core
  class bank,onec,tax,reg,manual src
